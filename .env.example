# Optional local overrides. The starter itself does not require secrets.
# npm start reads process environment variables; it does not auto-load
# .env or .env.local. Export these values, pass them inline, or configure
# them in your host before starting the server.

GRID_HOST=127.0.0.1
GRID_PORT=3000

# Optional: allow Chrome extension API calls to the local clipper server.
# Use the extension ID from chrome://extensions, or full chrome-extension:// origins.
# ALLOWED_CHROME_EXTENSION_IDS=abcdefghijklmnopabcdefghijklmnop
# ALLOWED_EXTENSION_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop

# Optional: allow another explicit web origin to call the local API.
# Same-port localhost origins already work without configuration.
# ALLOWED_API_ORIGINS=http://127.0.0.1:4173
