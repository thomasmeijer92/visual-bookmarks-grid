{
  "manifest_version": 3,
  "name": "Visual Grid Clipper",
  "version": "0.1.0",
  "description": "Save pages and images to a local Visual Bookmarks Grid.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Save to Visual Grid",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
